# The 2.5.0 rig, kept on disk as a migration reference only. Not part of 3.0.
reference/

# Show assets live on disk, not in git — shows are performed locally. The exceptions
# are the small demo set the public page needs, and the manifest that indexes it.
#
# The committed manifest lists ONLY the demo assets. Locally, the dev server serves
# assets/manifest.json dynamically from disk instead, so it lists everything you
# actually have — the client requests the same path either way and cannot tell which
# it got. Regenerate the committed one with `node scripts/build-manifests.js`.
assets/*
!assets/demo/
!assets/manifest.json

# ...and the metadata sidecar. The art itself is not in git, but the PROVENANCE is the
# point — who made a thing, when, and where it came from is the part worth keeping. It
# also carries the `face` boxes that align:"face" art is registered by, which are slow to
# re-derive by hand and would otherwise be lost with a checkout.
!assets/meta.json

# ...except the big media. The demo set exists to show the rig off on GitHub Pages, and a
# 2.6MB mp3 is not worth carrying in git for that. It stays on disk, so the show still has
# sound locally; the baked manifest lists only what git actually tracks, so the public
# page never asks for a file that is not there.
assets/demo/005_circus_theme.mp3

# The potato model itself is 12MB and loads from jsDelivr in production, but its 35-byte
# metadata does not — and a missing imgsz silently falls back to a default that would be
# wrong the moment the model is retrained at another size.
!assets/models/
assets/models/*
!assets/models/potato.meta.json

# The textures folder is source material and stays local, EXCEPT the one the show
# actually uses — otherwise the public build 404s and silently has no paper. Re-include
# the directory, re-exclude its contents, then name the exceptions.
!assets/textures/
assets/textures/*
!assets/textures/cardstock.jpeg
!assets/textures/lined_paper.jpeg
!assets/fonts/
!assets/textures/paper-tile.png

# Potato training artefacts — best.pt, dataset/, runs/, train.log. ~97MB, kept on disk
# because retraining needs them, but never committed (§9.9). The runtime model itself
# lives in assets/models/ and is already covered by `assets/*`.
potato_model/

# Baked at build time by scripts/build-manifests.js for static hosting.
manifests/

node_modules/
.DS_Store
*.log

# Rolling backups of script.json, written by the dev server before each save.
shows/*/.backups/
# ...and of assets/meta.json, written before each save by the same route.
assets/.backups/

# keynote-parser venv for scripts/import-keynote.py (scripts/try-keynote-parser.sh)
.venv-kp/
